<?xml version="1.0" encoding="UTF-8"?>
<!--
  "Sharp Studio Dark" editor colour scheme.

  It keeps Rider's bundled "Visual Studio Dark" scheme as its parent (so every
  token type that is not listed below - including the C#/ReSharper specific
  ones - keeps the exact Visual Studio 2022 colour), and re-states the core
  tokens here so the theme still looks right if the parent scheme is missing.
-->
<scheme name="Sharp Studio Dark" version="142" parent_scheme="Visual Studio Dark">
  <metaInfo>
    <property name="ide">Rider</property>
    <property name="originalScheme">Sharp Studio Dark</property>
  </metaInfo>

  <colors>
    <option name="CARET_COLOR" value="bbbbbb" />
    <option name="CARET_ROW_COLOR" value="272727" />
    <option name="SELECTION_BACKGROUND" value="264f78" />
    <option name="SELECTION_FOREGROUND" value="ffffff" />
    <option name="GUTTER_BACKGROUND" value="1e1e1e" />
    <option name="LINE_NUMBERS_COLOR" value="858585" />
    <option name="CONSOLE_BACKGROUND_KEY" value="1e1e1e" />
    <option name="CONSOLE_FOREGROUND_KEY" value="cccccc" />
    <option name="INDENT_GUIDE" value="333333" />
    <option name="WHITESPACES" value="3b3b3b" />
    <option name="FOLDED_TEXT_BORDER_COLOR" value="43474a" />
    <option name="TEARLINE_COLOR" value="3f3f46" />
    <option name="ADDED_LINES_COLOR" value="384c38" />
    <option name="MODIFIED_LINES_COLOR" value="4b3e21" />
    <option name="DELETED_LINES_COLOR" value="656e76" />
  </colors>

  <attributes>
    <option name="TEXT">
      <value>
        <option name="FOREGROUND" value="d4d4d4" />
        <option name="BACKGROUND" value="1e1e1e" />
      </value>
    </option>
    <!--
      Visual Studio 2026 editor palette (applied on top of Rider's bundled
      "Visual Studio Dark" parent scheme; see tools/vs_editor.py):
      the C# keyword family is purple #D8A0DF, Razor directives keep #A699E6,
      Razor components are teal, HTML tags are grey and HTML attribute values
      are string-orange -- exactly as in the user's Visual Studio screenshots.
    -->
    <option name="DEFAULT_KEYWORD">
      <value>
        <option name="FOREGROUND" value="d8a0df" />
      </value>
    </option>
